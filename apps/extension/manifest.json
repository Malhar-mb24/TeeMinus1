{
  "manifest_version": 3,
  "name": "Ember Focus & Wellbeing Companion",
  "version": "0.2.0",
  "description": "Privacy-first active tab time tracker for Ember. Hostname-only local aggregation; syncs only with explicit user opt-in.",
  "permissions": ["tabs", "idle", "storage", "alarms"],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*.vercel.app/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Ember Wellbeing Companion",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png"
    }
  },
  "options_page": "options.html"
}
