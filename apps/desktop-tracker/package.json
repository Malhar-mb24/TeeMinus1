{
  "name": "@ember/desktop-tracker",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "bin": {
    "ember-desktop-tracker": "./dist/cli.js"
  },
  "scripts": {
    "build": "esbuild src/cli.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/cli.js --banner:js=\"#!/usr/bin/env node\"",
    "start": "node dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ember/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "esbuild": "^0.27.2",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
