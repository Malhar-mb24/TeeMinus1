# ==============================================================================
# EMBER — ENVIRONMENT VARIABLES EXAMPLE
# Copy this file to .env.local (or apps/web/.env.local) and fill in real values.
# NEVER commit real secrets or database credentials to source control.
# ==============================================================================

# --- Neon PostgreSQL (Server-only) ---
# Obtain from Neon Console -> Connection Details (use pooled connection string for serverless)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/ember?sslmode=require

# --- Clerk Authentication ---
# Publishable key (safe for browser bundle)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_with_clerk_publishable_key
# Secret key (server-only, NEVER prefix with NEXT_PUBLIC_)
CLERK_SECRET_KEY=sk_test_replace_with_clerk_secret_key

# Clerk route configuration
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# --- Application URL ---
# Local development default; set to your Vercel domain in production
NEXT_PUBLIC_APP_URL=http://localhost:3000
